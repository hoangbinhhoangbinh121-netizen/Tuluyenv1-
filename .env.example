# --- bắt buộc ---
DISCORD_TOKEN=dán_token_bot_vào_đây
# --- khuyên dùng: ID server để lệnh slash hiện NGAY (bỏ trống = đăng ký toàn cục, chậm tới ~1 giờ) ---
GUILD_ID=
# --- tuỳ chọn ---
COMMAND_PREFIX=?,!   # tiền tố lệnh chữ, cách nhau bằng dấu phẩy. Bản Python cũ dùng "?" (vd ?tuluyen, ?danhboss)
ENABLE_PREFIX_COMMANDS=1        # 0 = chỉ dùng slash (không cần bật Message Content Intent)
TULUYEN_DB_PATH=                # mặc định data/tutien.db — trỏ vào ổ đĩa bền vững của hosting (VD /data/tutien.db)
TULUYEN_EMOJI_AUTOSYNC=1        # 0 = không tự upload emoji pixel
GEMINI_API_KEY=                 # tuỳ chọn (random tên công pháp/đan dược, log PvP)
AUTO_BACKUP_HOURS=6             # 0 = tắt tự sao lưu
AUTO_BACKUP_KEEP=8

# ID Discord của bạn (và admin khác, cách nhau bằng dấu phẩy) để dùng lệnh admin: /backupdb /restore_db /listdb ...
ADMIN_IDS=

# --- v7.0 ---
ERROR_LOG_CHANNEL_ID=           # (khuyên dùng) kênh admin nhận mã lỗi + stack tự động, khỏi phải mở console
ERROR_DM_ADMINS=0               # 1 = nhắn riêng cho admin khi có lỗi (nếu không đặt kênh ở trên)
WORLD_CHANNEL_ID=               # kênh thông báo toàn thế giới (hoặc dùng lệnh /datkenhthegioi trong kênh muốn chọn)
WORLD_ANNOUNCE_MIN_REALM=5      # chỉ thông báo toàn server khi đột phá đại cảnh giới từ chỉ số này (5 = Hóa Thần)
BOSS_ACTION_COOLDOWN=8          # giây hồi chiêu mỗi đòn đánh Boss
BOSS_DEFAULT_MINUTES=30         # số phút Boss tồn tại mặc định
