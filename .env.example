# ===== CHỈ CẦN 1 DÒNG NÀY LÀ BOT CHẠY ĐƯỢC =====
DISCORD_TOKEN=dán_token_bot_vào_đây

# Tất cả phần dưới đây là TUỲ CHỌN — bot đã tự động xử lý (xem src/autoconfig.js):
#  • Chủ bot (người tạo ứng dụng trên Developer Portal) tự động là admin.
#  • Lệnh slash tự đăng ký ngay cho MỌI server bot đang ở (và server mới mời vào) — không cần GUILD_ID.
#  • Intent (Message Content / Server Members) chưa bật trong Developer Portal thì tự hạ cấu hình, không crash.
#  • Sao lưu DB: luôn chỉ giữ bản MỚI NHẤT, bản cũ tự xoá, tự dọn khi đầy đĩa. Gõ /dungluong để xem.
#  • Lỗi bot được nhắn riêng cho chủ bot (tối đa 1 tin / 5 phút).
#
# GUILD_ID=              # chỉ đăng ký lệnh cho 1 server
# ADMIN_IDS=             # thêm admin khác (cách nhau dấu phẩy)
# ERROR_LOG_CHANNEL_ID=  # gửi lỗi vào kênh thay vì nhắn riêng chủ bot
# WORLD_CHANNEL_ID=      # kênh thông báo toàn thế giới (hoặc dùng lệnh /datkenhthegioi)
# GEMINI_API_KEY=        # tuỳ chọn: random tên công pháp/đan dược, kể log PvP
# TULUYEN_DB_PATH=       # mặc định data/tutien.db
# CONFIG_FROM_ENV=1      # cho phép tự đặt AUTO_BACKUP_HOURS / AUTO_BACKUP_KEEP / BACKUP_KEEP_MANUAL / BACKUP_KEEP_PRE / BACKUP_MAX_MB

# ═══════════ TuTienStore (v16.8) — nạp tiền thật, nhận vật phẩm ═══════════
# ── CÁCH 1 (khuyên dùng, TỰ ĐỘNG): tài khoản NGÂN HÀNG nhận tiền + SePay → QR có sẵn số tiền & nội dung, tiền về là bot tự giao.
# ── CÁCH 2 (ZaloPay/QR tĩnh, ADMIN DUYỆT TAY): bỏ trống 3 dòng STORE_BANK_ID/ACCOUNT_NO/ACCOUNT_NAME, bot dùng ảnh assets/store/qr.jpg.
# Mã ngân hàng theo VietQR: MB, VCB, TCB, ACB, BIDV, VPB, TPB, STB...
STORE_BANK_ID=
STORE_ACCOUNT_NO=
STORE_ACCOUNT_NAME=
# Nhận tiền TỰ ĐỘNG qua SePay (sepay.vn): đặt cùng giá trị này làm "API Key" ở webhook SePay. Bỏ trống = admin duyệt tay.
STORE_SEPAY_API_KEY=
# Cổng mở webhook (host dạng Pterodactyl thường tự có SERVER_PORT, khi đó không cần đặt)
STORE_WEBHOOK_PORT=
# Kênh Discord (ID) để báo đơn/sự cố cho admin. Bỏ trống = nhắn riêng admin.
STORE_ADMIN_CHANNEL_ID=
# Tuỳ chọn: tiền tố mã đơn (mặc định TTS), phút hiệu lực QR (mặc định 15), số đơn chờ tối đa/người (mặc định 3)
STORE_PAYMENT_PREFIX=TTS
STORE_ORDER_TTL_MIN=15
STORE_MAX_PENDING=3
# Chế độ QR tĩnh: đường dẫn ảnh QR (mặc định assets/store/qr.jpg — đã kèm sẵn). Điền STORE_ACCOUNT_NAME để hiện tên người nhận (vd HOANG SAO AN BINH)
STORE_QR_IMAGE=assets/store/qr.jpg
# Thiên Tệ (tiền ảo của shop): số Thiên Tệ gốc cho mỗi 1.000đ nạp (mặc định 10 → 1 Thiên Tệ = 100đ). Bảng thưởng theo bậc sửa trong src/store/topup.js
STORE_TT_PER_1K=10
# 1 = khách vừa mua bằng Thiên Tệ vừa được chuyển khoản trực tiếp từng món; 0 = CHỈ bán bằng Thiên Tệ (phải nạp trước)
STORE_DIRECT_BUY=1
